# Copy this file to .env and paste your real values. .env is git-ignored;
# this template is committed, so it must contain ONLY placeholders — never
# real secrets.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Secret used to sign auth (JWT) tokens. Use a long random string in production;
# generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enable "Sign in with Google".
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your app origin
# (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Leave blank/unset to keep Google sign-in disabled.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional: point the pipeline at different Groq models.
# MODEL_FAST=llama-3.1-8b-instant
# MODEL_QUALITY=llama-3.3-70b-versatile

# Optional: set to 1 to preload the embedding + reranker models at startup
# (slower boot, but the first query is fast). Default: load on first query.
# WARM_UP_MODELS=1
